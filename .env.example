# Optional, server-side only. Without a key, live Ethereum history uses Blockscout's
# keyless public explorer; the synthetic test fixture stays offline either way.
# Supply your own existing permitted Etherscan API key locally; never commit it.
# With a key, Etherscan serves Ethereum and Arbitrum One. It returns ETH and ERC-20
# transfers but not internal ones. Derive Chain always
# uses its own keyless Blockscout explorer, since Etherscan has no Derive history.
# Also enables prices read at each transfer's own block: those come from Uniswap
# swap logs, and the public RPC refuses the archive requests they would otherwise
# need. Without it, USD falls back to today's spot price and says so.
ETHERSCAN_API_KEY=

# Hosted Base, Arbitrum and explicitly expanded Robinhood Chain (4663) history can
# use a Blockscout API key, stored only here. A key is required on the free tier too.
# Chain access depends on the account plan; Base may require a paid plan. FlowLens
# never upgrades or purchases a plan.
BLOCKSCOUT_API_KEY=

# Optional operator-run Base Blockscout API, reached through a local loopback
# origin such as http://127.0.0.1:4010 (or an SSH tunnel to a remote host).
# Use only an http(s) origin on 127.0.0.1 or [::1], with no path, query,
# fragment or credentials. No Blockscout API key is needed or sent to this route.
# FLOWLENS_BLOCKSCOUT=off disables this route too; leave blank to use the
# configured hosted/Alchemy routes instead.
FLOWLENS_BASE_BLOCKSCOUT_URL=

# Optional server-local Base RPC source for known transaction/receipt/trace reads.
# Empty or publicnode keeps the existing PublicNode route; blockmachine selects
# the fixed keyless https://rpc-base.blockmachine.io endpoint. This is a
# best-effort known-transaction trace route, not Base wallet-history enumeration.
# Invalid values fail closed; no URL or key is accepted here or from API/MCP input.
FLOWLENS_BASE_RPC_PROVIDER=

# Optional Base history route using your own Alchemy key; chosen for Base when set.
# This remains server-side. Account quotas and trace availability still apply.
# Without it, Base uses keyed Blockscout and requires Base plan access.
ALCHEMY_API_KEY=

# Keyless HyperEVM history uses HypurrTrace for the explicitly selected wallet.
# Set off to disable those requests. HyperCore uses Hyperliquid's public info API.
FLOWLENS_HYPURRTRACE=

# Keyless live history sends each traced wallet to eth.blockscout.com, and Derive Chain
# expansions to explorer.derive.xyz. Set to off to keep wallets away from those routes;
# it also disables self-hosted and keyed Blockscout routes. Ethereum then needs
# Etherscan; Derive is unavailable. Alchemy and HypurrTrace are configured separately.
FLOWLENS_BLOCKSCOUT=

# Optional standalone Telegram outflow watcher. Keep the bot token and chat ID
# only on the VPS; this example intentionally leaves both empty. The watcher
# currently supports Ethereum (chain 1) and bootstraps existing rows silently.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FLOWLENS_WATCH_ADDRESSES=
FLOWLENS_WATCH_CHAIN_ID=
FLOWLENS_WATCH_INTERVAL_MS=
FLOWLENS_WATCH_PROVIDER_INTERVAL_MS=
FLOWLENS_WATCH_MAX_ALERT_AGE_MS=
FLOWLENS_WATCH_MIN_INFLOW_USD=
# Set to none to keep polling/state current without sending slow-worker alerts.
FLOWLENS_WATCH_ALERT_KINDS=
FLOWLENS_WATCH_STATE_FILE=

# Optional low-latency ERC-20 watcher. It discovers token contracts from the
# configured wallets through Blockscout, then scans confirmed Ethereum logs via
# PublicNode. Newly unseen token contracts remain outside coverage until refresh.
FLOWLENS_FAST_WATCH_ADDRESSES=
# Optional separate entity scope for current Ethereum token totals. Keep all
# related addresses here; this does not expand the low-latency event watcher.
FLOWLENS_ENTITY_ETHEREUM_ADDRESSES=
# Optional manual ERC-20 contracts, including fully dumped tokens no longer in
# current balances. Comma-separated contract addresses.
FLOWLENS_FAST_TOKEN_ADDRESSES=
FLOWLENS_FAST_RPC_URL=
FLOWLENS_FAST_INTERVAL_MS=
FLOWLENS_FAST_CONFIRMATIONS=
FLOWLENS_FAST_MAX_BLOCK_SPAN=
FLOWLENS_FAST_TOKEN_REFRESH_MS=
FLOWLENS_FAST_STATE_FILE=

# Optional standalone Bitcoin watcher. mempool.space is keyless; use a
# conservative interval and keep the address list and state on the VPS.
FLOWLENS_BTC_ADDRESSES=
FLOWLENS_BTC_INTERVAL_MS=
FLOWLENS_BTC_PROVIDER_INTERVAL_MS=
FLOWLENS_BTC_MAX_ALERT_AGE_MS=
FLOWLENS_BTC_STATE_FILE=

# Optional isolated Arbitrum One direct-transfer watcher. The wallet is kept
# runtime-only; ARB uses its canonical contract by default. Native ETH covers
# direct transaction values, not internal contract transfers.
FLOWLENS_ARBITRUM_WATCH_ADDRESS=
FLOWLENS_ARBITRUM_ARB_CONTRACT=
FLOWLENS_ARBITRUM_INTERVAL_MS=
FLOWLENS_ARBITRUM_CONFIRMATIONS=
FLOWLENS_ARBITRUM_MAX_BLOCK_SPAN=
FLOWLENS_ARBITRUM_MAX_ALERT_AGE_MS=
FLOWLENS_ARBITRUM_MIN_INFLOW_USD=
FLOWLENS_ARBITRUM_PRICE_REFRESH_MS=
FLOWLENS_ARBITRUM_STATE_FILE=

# Optional standalone confirmed Tron watcher. TronGrid is keyless at low volume;
# keep a TRON-PRO-API-KEY on the VPS when available for dependable polling.
TRON_WATCH_ADDRESSES=
TRONGRID_API_KEY=
TRONGRID_BASE_URL=
TRON_WATCH_INTERVAL_MS=
TRON_PROVIDER_INTERVAL_MS=
TRON_WATCH_MAX_ALERT_AGE_MS=
TRON_WATCH_STATE_FILE=

# Optional standalone confirmed Solana watcher. Keep the address list, shared
# Telegram credentials and any provider keys only on the VPS.
FLOWLENS_SOLANA_ADDRESSES=
FLOWLENS_SOLANA_RPC_URL=
FLOWLENS_SOLANA_HELIUS_API_KEY=
HELIUS_API_KEY=
JUPITER_API_KEY=
FLOWLENS_SOLANA_INTERVAL_MS=
FLOWLENS_SOLANA_PROVIDER_INTERVAL_MS=
FLOWLENS_SOLANA_MAX_ALERT_AGE_MS=
FLOWLENS_SOLANA_MIN_ALERT_USD=
FLOWLENS_SOLANA_BACKFILL=
FLOWLENS_SOLANA_STATE_FILE=

# No Arkham client is enabled. A key alone does not establish integration rights.

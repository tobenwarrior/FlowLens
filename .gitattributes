# Auto detect text files and perform LF normalization
* text=auto

# Keep source checks and deterministic exports consistent across platforms.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.svg text eol=lf
*.css text eol=lf
*.html text eol=lf
*.toml text eol=lf
*.png -text
LICENSE text eol=lf

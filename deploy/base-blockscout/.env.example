# Copy this file to .env on the future archive host and fill every required
# value. Do not commit .env. Image values must be immutable official digests.

BLOCKSCOUT_OP_IMAGE=
POSTGRES_IMAGE=
REDIS_IMAGE=

POSTGRES_PASSWORD=
SECRET_KEY_BASE=

# These endpoints must be reachable from the Blockscout backend container.
# HTTP and trace require an archive-capable Base RPC; WS is used for live work.
ETHEREUM_JSONRPC_HTTP_URL=
ETHEREUM_JSONRPC_TRACE_URL=
ETHEREUM_JSONRPC_WS_URL=

# Ethereum mainnet RPC used by Optimism/Base enrichment.
INDEXER_OPTIMISM_L1_RPC=

# Optional EIP-4844 blob fallback. Leave these values empty unless the
# operator has configured the Blockscout blob endpoint and matching beacon data.
INDEXER_DISABLE_BEACON_BLOB_FETCHER=
INDEXER_OPTIMISM_L1_BATCH_BLOCKSCOUT_BLOBS_API_URL=
INDEXER_BEACON_RPC_URL=
INDEXER_BEACON_BLOB_FETCHER_REFERENCE_SLOT=
INDEXER_BEACON_BLOB_FETCHER_REFERENCE_TIMESTAMP=
INDEXER_BEACON_BLOB_FETCHER_SLOT_DURATION=

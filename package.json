{
  "name": "flowlens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, evidence-first EVM tracing for agents and investigators",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4318 --strictPort",
    "server": "node server/index.ts",
    "cli": "node server/cli.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write src server tests scripts eslint.config.js vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src server tests scripts eslint.config.js vite.config.ts tsconfig.json package.json",
    "mcp": "node server/mcp.ts",
    "lint": "eslint . --max-warnings 0",
    "release:check": "node scripts/release.mjs --check",
    "release:source": "node scripts/release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.57.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.0"
  }
}
